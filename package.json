{
  "name": "webrectangle",
  "version": "3.0.0",
  "private": true,
  "description": "WebRectangle - influencer marketing platform marketing site",
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 15.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/mdx": "^2.0.14",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^13.0.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
